{
    "name": "devflow/telegram-bot",
    "description": "A clean PHP library for building Telegram bots with a static facade, fluent routing, and premade database schemas.",
    "version": "1.5.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["telegram", "bot", "api", "webhook", "laravel", "scaffold"],
    "bin": ["bin/devflow"],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Devflow\\TelegramBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devflow\\TelegramBot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devflow\\TelegramBot\\Laravel\\TelegramBotServiceProvider"
            ],
            "aliases": {
                "TelegramBot": "Devflow\\TelegramBot\\Laravel\\Facades\\TelegramBot"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
